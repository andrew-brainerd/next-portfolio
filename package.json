{
  "name": "next-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "next build",
    "analyze": "next experimental-analyze",
    "clean": "rm -rf node_modules .next",
    "dev": "next dev --experimental-https --hostname local.brainerd.dev --port 3001",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --project=setup",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:fix": "pnpm lint:js:fix && pnpm lint:css:fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "preinstall": "bash scripts/installHooks.sh",
    "start": "next start",
    "update-packages": "npx npm-check-updates@latest -u && pnpm i && git add . && git commit -m \"Update packages\"",
    "test": "vitest run",
    "verify": "tsc --noEmit && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1174.0",
    "@aws-sdk/s3-request-presigner": "^3.1174.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@next/third-parties": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "firebase": "^13.4.0",
    "howlongtobeat": "^1.8.0",
    "leaflet": "^1.9.4",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "page-flip": "^2.0.7",
    "postcss": "^8.5.33",
    "pusher-js": "^8.6.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/qrcode": "^1.5.6",
    "lint-staged": "^17.6.1",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-order": "^8.1.3",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "**/*": "npx prettier --write --ignore-unknown"
  }
}
